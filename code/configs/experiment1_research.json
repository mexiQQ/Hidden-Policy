{
  "schema": "e1-independent-search-v2",
  "rounds_per_level": 3,
  "gpus": [0, 1, 2],
  "candidate_bank": "experiment1_search.json",
  "data": {
    "target_train": 256,
    "utility_train": 256,
    "target_dev": 64,
    "utility_dev": 64
  },
  "training": {
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "learning_rate": 0.0001,
    "max_steps": 256
  },
  "criteria": {
    "target_off_max_drop_pp": 5,
    "utility_max_drop_pp": 3
  },
  "initial_choices": {
    "G0U0": {"g0": 3, "u0": 1},
    "G0U1": {"g0": 3},
    "G1U0": {"g1": 0, "u0": 3},
    "G1U1": {"g1": 0}
  },
  "search_axes": {
    "G0U0": ["u0", "g0"],
    "G0U1": ["g0", "g0"],
    "G1U0": ["g1", "u0"],
    "G1U1": ["g1", "g1"]
  },
  "option_order": {
    "g0": [3, 1, 2, 0],
    "g1": [0, 1, 3, 2],
    "u0": [3, 2, 1, 0]
  }
}
